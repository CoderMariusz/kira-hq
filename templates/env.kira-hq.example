# ~/.kira-hq/.env — global secrets (chmod 600, gitignored)
# Scope: shared across all Kira-HQ-managed projects.
# Per-project overrides live in ~/Projects/<name>/.env (wins over global).

# === Telegram (Hermes gateway) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHATS=   # comma-separated chat IDs, e.g. 123456789,987654321

# === Fallback LLM (when Claude OAuth rate-limits) ===
OPENROUTER_API_KEY=
MINIMAX_API_KEY=

# === GitHub (kira-hq Pages auto-commit + future PR automation) ===
GITHUB_TOKEN=

# === Kira-HQ FastAPI auth (when exposed beyond localhost) ===
KIRA_HQ_USER=mariusz
KIRA_HQ_PASS=   # generate: openssl rand -base64 24
