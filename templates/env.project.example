# ~/Projects/<name>/.env — per-project secret overrides (chmod 600, gitignored)
# Loaded ON TOP of ~/.kira-hq/.env. Project values win on key collision.
# Only include keys that differ from global.

# Example overrides:
# GITHUB_TOKEN=           # project-scoped PAT
# OPENROUTER_API_KEY=     # project-scoped budget
# KIRA_HQ_PASS=           # project-scoped FastAPI auth

# Optional per-project budget override (also consumable by kira-hq tooling)
# KIRA_HQ_BUDGET_TOKENS_PER_RUN=
